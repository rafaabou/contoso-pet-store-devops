# Copy this file to .env and fill in your own values.
# NEVER commit a real key. .env is ignored by git and docker build.

# Primary provider: Gemini (Google AI Studio) - free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Backup provider: NVIDIA NIM - free key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=openai/gpt-oss-20b
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-schnell

# Last-resort image provider: Cloudflare Workers AI - free plan (10,000 Neurons/day).
# Dashboard -> Workers AI -> "Use REST API" gives you both values on one page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# 4th image fallback: xKiro gateway - free plan (dashboard -> API Keys, no card).
# Free image quota is "limited" (a few images per rolling 24h); the API is async
# (job id + polling, handled in code).
XKIRO_API_KEY=
XKIRO_IMAGE_MODEL=sensenova/sensenova-u1.5-lite

# Failover chain order (a provider is only used if its API key is set)
AI_TEXT_PROVIDERS=gemini,nvidia
AI_IMAGE_PROVIDERS=gemini,cloudflare,xkiro

# Fire all armed image providers at once, first success wins (default: sequential).
# Parallel is faster but EVERY call burns quota on ALL providers - opt in only.
AI_IMAGE_PARALLEL=false