---
# OpenTelemetry Collector Configuration
# Docs: https://opentelemetry.io/docs/collector/configuration/

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:{{ otel_grpc_port }}
      http:
        endpoint: 0.0.0.0:{{ otel_http_port }}

  # Receive Prometheus metrics from K3s nodes
  prometheus:
    config:
      scrape_configs:
        - job_name: "otelcol"
          static_configs:
            - targets: ["localhost:{{ otel_metrics_port }}"]

processors:
  batch:
    timeout: 1s
    send_batch_size: 1024

  memory_limiter:
    check_interval: 1s
    limit_mib: 512
    spike_limit_mib: 128

exporters:
  # Export traces to Jaeger
  otlp/jaeger:
    endpoint: "localhost:{{ jaeger_grpc_port }}"
    tls:
      insecure: true

  # Export metrics to Prometheus
  prometheus:
    endpoint: "0.0.0.0:8889"
    namespace: "otel"

  # Export logs to Loki via OTLP/HTTP
  otlphttp/loki:
    endpoint: "http://localhost:{{ loki_port }}/loki/api/v1/otlp"

extensions:
  health_check:
    endpoint: 0.0.0.0:13133
  zpages:
    endpoint: 0.0.0.0:55679

service:
  extensions: [health_check, zpages]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [otlp/jaeger]
    metrics:
      receivers: [otlp, prometheus]
      processors: [memory_limiter, batch]
      exporters: [prometheus]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [otlphttp/loki]
