---
# Alertmanager configuration (TASK-263 step 3: Telegram paging from Vault).
# Route: everything to Telegram; critical repeats hourly, rest every 4h.
# Token/chat land here ONLY via Vault facts (no_log upstream) — never commit values.
global:
  resolve_timeout: 5m

route:
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'telegram'
  routes:
    - matchers: [severity = 'critical']
      group_wait: 10s
      repeat_interval: 1h
      receiver: 'telegram'

receivers:
  - name: 'telegram'
    telegram_configs:
      - bot_token: '{{ alertmanager_bot_token }}'
        chat_id: {{ alertmanager_chat_id }}
        send_resolved: true
