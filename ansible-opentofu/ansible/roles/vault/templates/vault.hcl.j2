storage "file" {
  path = "/opt/vault/data"
}

listener "tcp" {
  address       = "0.0.0.0:8200"
  tls_cert_file = "/etc/vault.d/vault.crt"
  tls_key_file  = "/etc/vault.d/vault.key"
}

api_addr = "https://{{ ansible_host }}:8200"
cluster_addr = "https://{{ ansible_host }}:8201"

ui = true
disable_mlock = true
