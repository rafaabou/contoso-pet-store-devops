#!/bin/bash
# Auto-unseal helper (TASK: seal-after-reboot fix). Root-only (0700).
# Sealed-check first: idempotent no-op when already open; reboots are the
# only trigger. Key passes through a variable into stdin-free CLI args —
# never echoed, never logged (set +x absent deliberately).
set -u
export VAULT_ADDR="https://127.0.0.1:8200" VAULT_SKIP_VERIFY="true"
SEALED="$(vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null)"
[ "$SEALED" = "true" ] || exit 0
UNSEAL_KEY="$(jq -r '.unseal_keys_b64[0]' /root/vault-init.json)"
vault operator unseal "$UNSEAL_KEY" >/dev/null
